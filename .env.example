# MarketAtlas Memory Service — Environment Configuration
# All vars use the MATLAS_ prefix

# Server
MATLAS_API_HOST=0.0.0.0
MATLAS_API_PORT=8010
MATLAS_DEBUG=True

# PostgreSQL (episode metadata)
MATLAS_POSTGRES_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/marketatlas

# Qdrant (vector embeddings)
MATLAS_QDRANT_URL=http://localhost:6333
MATLAS_QDRANT_COLLECTION=episode_embeddings

# Neo4j (knowledge graph)
MATLAS_NEO4J_URI=bolt://localhost:7687
MATLAS_NEO4J_USER=neo4j
MATLAS_NEO4J_PASSWORD=password

# S3-compatible object storage (raw articles)
MATLAS_S3_BUCKET=marketatlas-memory
MATLAS_S3_ENDPOINT=

# Embedding model
MATLAS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MATLAS_EMBEDDING_DIM=384

# Redis
MATLAS_REDIS_URL=redis://localhost:6379/0
