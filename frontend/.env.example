# MarketAtlas frontend — copy to `.env.local` and adjust if your backend is
# not on localhost:8000.

# Base URL the Vite dev server *and* `npm run preview` proxy `/api` and `/ws`
# to. Read at config time (see vite.config.ts), so it must be reachable from
# the machine running Vite — not from the visitor's browser.
VITE_API_BASE_URL=http://localhost:8000

# Optional: absolute WebSocket origin for the simulation bridge. Left empty,
# it derives the origin from the current page.
VITE_SIMULATOR_WS_URL=
