# MarketAtlas backend — copy to `.env` and fill in.
#
# Required for the full live demo: the PostgreSQL + Redis block and one LLM key.
# Everything else is optional and the app degrades gracefully when unset
# (see docs/DEPLOYMENT.md → "Graceful degradation").

# ── API ──────────────────────────────────────────────────────────────
API_TITLE=MarketAtlas
API_VERSION=1.0.0
API_DEBUG=False
# development | production. `production` requires JWT_SECRET to be set.
APP_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
# Require a server-issued captcha on /auth/register and /auth/login (default: True).
AUTH_CAPTCHA_ENABLED=True
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# ── Database (PostgreSQL) ────────────────────────────────────────────
DB_DRIVER=postgresql+asyncpg
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketatlas
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=False

# ── Redis / Celery ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Optional microservices (related features degrade when absent) ─────
MARKET_AGENTS_URL=http://localhost:8004
KG_AGENT_URL=http://localhost:8008
GRAPH_ENGINE_URL=http://localhost:8005
WORLD_STATE_URL=http://localhost:8006
WORLD_STATE_API_KEY=replace-with-a-separate-long-random-service-key
MEMORY_URL=http://localhost:8010
SIMULATOR_URL=http://localhost:8007

# ── LLM providers (at least one enables provider-backed ATLAS answers;
#    without one the chatbot still answers from canonical evidence) ────
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro
GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
ASSISTANT_REALTIME_MODEL=gpt-realtime-2.1
ASSISTANT_REALTIME_VOICE=marin

# ── Market data provider ─────────────────────────────────────────────
# Optional: Alpha Vantage for US quotes. yfinance is the free fallback and is
# used automatically when this is empty or when the provider returns nothing.
ALPHA_VANTAGE_API_KEY=

# ── Sector market data feed ──────────────────────────────────────────
# Semicolon-separated 'sector:ticker1,ticker2' pairs; TTL in seconds.
SECTOR_TICKERS=technology:AAPL,MSFT,NVDA;semiconductors:AMD,INTC,AVGO;energy:XOM,CVX,COP;defense:LMT,RTX,NOC;financials:JPM,BAC,GS;healthcare:JNJ,UNH,LLY;consumer_cyclical:AMZN,TSLA,HD;consumer_defensive:PG,KO,WMT;utilities:NEE,DUK,SO;materials:LIN,SHW,FCX;commodities:GLD,SLV,USO
SECTOR_CACHE_TTL_SECONDS=1800

# ── Optional geopolitical ingestion keys (extra sources) ──────────────
GNEWS_KEY=
ACLED_EMAIL=
ACLED_KEY=

# ── Feature flags ────────────────────────────────────────────────────
ENABLE_WORKERS=True